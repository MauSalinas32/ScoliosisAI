\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}UML Use Case Diagram}{17}{subsection.7.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces UML use case diagram. The four actors are the four roles of the RBAC matrix (Table~\ref {tab:rbac}); all four specialise the abstract \emph  {Staff} actor and therefore inherit UC-01 to UC-04. Only the Radiologist reviews (UC-07); Radiologist and Admin read results and generate reports (UC-06, UC-08); Admin and ML Engineer read the audit trail. The AI model is an internal component, not an actor. UC-11 is performed with the command-line tools on the ML engineer's workstation, not through the clinical API.}}{17}{figure.caption.12}\protected@file@percent }
\newlabel{fig:usecase}{{6}{17}{UML use case diagram. The four actors are the four roles of the RBAC matrix (Table~\ref {tab:rbac}); all four specialise the abstract \emph {Staff} actor and therefore inherit UC-01 to UC-04. Only the Radiologist reviews (UC-07); Radiologist and Admin read results and generate reports (UC-06, UC-08); Admin and ML Engineer read the audit trail. The AI model is an internal component, not an actor. UC-11 is performed with the command-line tools on the ML engineer's workstation, not through the clinical API}{figure.caption.12}{}}
