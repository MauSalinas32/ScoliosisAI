\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Preprocessing pipeline. Stage~1 implements Fail-Fast: the first failing check raises a typed exception, the remaining stages do not run (\nolinkurl  {test_pipeline_stops_at_first_failure}) and the API maps it to HTTP 413 or 422. The same decoder (\texttt  {decode\_image}) is used at upload and at classification, so DICOM files can be both uploaded and classified.}}{13}{figure.caption.8}\protected@file@percent }
\newlabel{fig:pipeline}{{3}{13}{Preprocessing pipeline. Stage~1 implements Fail-Fast: the first failing check raises a typed exception, the remaining stages do not run (\fp {test_pipeline_stops_at_first_failure}) and the API maps it to HTTP 413 or 422. The same decoder (\texttt {decode\_image}) is used at upload and at classification, so DICOM files can be both uploaded and classified}{figure.caption.8}{}}
