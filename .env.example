# Copy to .env (never commit .env) and replace every value.
POSTGRES_PASSWORD=change-me
# At least 32 random characters, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-0123456789
# development = demo users (password123) and 2FA codes in the console; production = no demo users, no codes in logs
ENVIRONMENT=development
# Only used when ENVIRONMENT=production (password of the first administrator)
INITIAL_ADMIN_PASSWORD=
